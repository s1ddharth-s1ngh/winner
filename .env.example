# Leave empty to run with the local demo backend (data stored in this browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public web address used in invite links (needed for the Android build, e.g. https://<user>.github.io/<repo>/).
# Leave empty on the web: the current address is used.
VITE_PUBLIC_URL=

# Server-only secrets for the `garmin` edge function. Never put them in .env: set them with
#   npx supabase secrets set GARMIN_ENC_KEY=...
# GARMIN_ENC_KEY = random string, 32+ chars (openssl rand -hex 32). Encrypts stored Garmin API keys.
# The pg_cron secret is generated inside Supabase Vault (docs/guides/garmin.md), not set by hand.
